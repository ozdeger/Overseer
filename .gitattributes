# Normalize all text to LF in the repo; check out LF everywhere.
* text=auto eol=lf

# Windows batch must stay CRLF
*.bat text eol=crlf

# Keep these LF explicitly
*.kt   text eol=lf
*.kts  text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
gradlew text eol=lf

# Binary (never touch)
*.jar binary
*.png binary
*.ico binary
